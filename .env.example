AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=scoring
PUSHER_APP_KEY=scoring
PUSHER_APP_SECRET=12314
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

##  APPLICATION SETTINGS
# Enable/disable role-based authorization
# Set to 'true' for production, 'false' for demo/development
MANAGEMENT_ROLE=false

# Laravel WebSocket Settings (for real-time scoring)
LARAVEL_WEBSOCKETS_PORT=6001
LARAVEL_WEBSOCKETS_DOMAIN=null

# WebSocket Performance Settings
WEBSOCKET_MAX_CONNECTIONS=500
WEBSOCKET_STATISTICS=false

# Database Performance Monitoring (LATENCY OPTIMIZATION)
# Enable slow query logging to identify database bottlenecks
DB_QUERY_LOGGING=true
DB_SLOW_QUERY_MS=500

# Ultra-verbose database debugging (disable in production)
# Logs every database query - use only for diagnosing severe latency issues
DB_QUERY_DEBUG=false
